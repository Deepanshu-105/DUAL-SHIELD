FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      python3 ipset iptables iproute2 && \
    rm -rf /var/lib/apt/lists/*
# v9: listener.py, chainlib.py and entrypoint.sh are mounted from ./network at /opt/shield (docker-compose.yml)
ENTRYPOINT ["/opt/shield/entrypoint.sh"]
