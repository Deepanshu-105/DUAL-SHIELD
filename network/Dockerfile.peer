FROM ubuntu:22.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      python3 python3-pip ipset iptables iproute2 && \
    pip3 install --no-cache-dir web3 websockets eth-abi && \
    rm -rf /var/lib/apt/lists/*

COPY network/listener.py /opt/shield/listener.py
COPY network/entrypoint.sh /opt/shield/entrypoint.sh
RUN chmod +x /opt/shield/entrypoint.sh

ENTRYPOINT ["/opt/shield/entrypoint.sh"]
