# Copy to multi/config.env on EVERY laptop and fill in the four LAN addresses (same file on all four).
# Get each address on its own laptop with:  hostname -I   (use the 192.168.x.x or 10.x.x.x one)
D_IP=192.168.1.10     # D = dashboard + blockchain laptop
T_IP=192.168.1.11     # T = target laptop (SSH server, parser, ransomware watcher)
P_IP=192.168.1.12     # P = peer laptop (listens to the chain, blocks the attacker)
A_IP=192.168.1.13     # A = attacker laptop (Hydra)

# v2 secrets. Create them with:  multi/gen_secrets.sh   and paste the three lines here.
# D needs all three. T needs only AGENT_SECRET_T. P needs only AGENT_SECRET_P. A needs none.
# (You may delete the lines a laptop does not need. Never commit this file.)
AGENT_SECRET_T=
AGENT_SECRET_P=
DASH_PASS=

# Layer 2 recovery on T: 1 = the agent starts guard.py (continuous vault + kill rule + containment) for the
# demo attack; 0 = the old plain watcher only. The dashboard "Recovery vault" panel needs 1.
GUARD=1

# v3 network layer (both off by default, so nothing changes unless you turn them on):
#   FLOOD=1      T also runs detector/flood_detector.py (DDoS, UDP flood, port scan, botnet) into the same chain pipeline.
#   BLOCK_TTL=N  T and P lift a block after N seconds (for example 3600) so a false positive is not permanent.
FLOOD=0
BLOCK_TTL=0

# v4 detectors on T (all off by default):
#   LOGIN_WATCH=1  slow brute force, password spraying, logins after failures / from Tor
#   ARP_WATCH=1    ARP spoofing (man-in-the-middle) on the local network
LOGIN_WATCH=0
ARP_WATCH=0

# v5 hardening (all optional, off when empty):
#   CHAIN_IP_KEY      same secret on D, T and P: threat records on the chain are stored encrypted (privacy).
#   WHITELIST_CIDRS   networks never to block, comma list, e.g. 10.0.0.0/8,192.168.0.0/16 (shared campus / mobile NAT)
#   SELFGUARD_KEY     secret that signs the defenders' code manifest (multi/selfguard.py)
CHAIN_IP_KEY=
WHITELIST_CIDRS=
SELFGUARD_KEY=
