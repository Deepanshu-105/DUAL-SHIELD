# Copy to multi/config.env on EVERY laptop and fill in the four LAN addresses (same file on all four).
# Get each address on its own laptop with:  hostname -I   (use the 192.168.x.x or 10.x.x.x one)
D_IP=192.168.1.10     # D = dashboard + blockchain laptop
T_IP=192.168.1.11     # T = target laptop (SSH server, parser, ransomware watcher)
P_IP=192.168.1.12     # P = peer laptop (listens to the chain, blocks the attacker)
A_IP=192.168.1.13     # A = attacker laptop (Hydra)

# v2 secrets. Create them with:  multi/gen_secrets.sh   and paste the three lines here.
# D needs all three. T needs only AGENT_SECRET_T. P needs only AGENT_SECRET_P. A needs none.
# (You may delete the lines a laptop does not need. Never commit this file.)
AGENT_SECRET_T=
AGENT_SECRET_P=
DASH_PASS=

# Layer 2 recovery on T: 1 = the agent starts guard.py (continuous vault + kill rule + containment) for the
# demo attack; 0 = the old plain watcher only. The dashboard "Recovery vault" panel needs 1.
GUARD=1
