# Copy to multi/config.env on EVERY laptop and fill in the four LAN addresses (same file on all four).
# Get each address on its own laptop with:  hostname -I   (use the 192.168.x.x or 10.x.x.x one)
D_IP=192.168.1.10     # D = dashboard + blockchain laptop
T_IP=192.168.1.11     # T = target laptop (SSH server, parser, ransomware watcher)
P_IP=192.168.1.12     # P = peer laptop (listens to the chain, blocks the attacker)
A_IP=192.168.1.13     # A = attacker laptop (Hydra)

# v2 secrets. Create them with:  multi/gen_secrets.sh   and paste the three lines here.
# D needs all three. T needs only AGENT_SECRET_T. P needs only AGENT_SECRET_P. A needs none.
# (You may delete the lines a laptop does not need. Never commit this file.)
AGENT_SECRET_T=
AGENT_SECRET_P=
DASH_PASS=
# v13 dashboard: DASH_VIEW_PASS = read-only account, DASH_SESSION_KEY = extra secret for session cookies, DASH_IDLE_S (default 1800), DEMO_MODE=0 hides the demo buttons, DASH_DEV=1 runs the dev server
DASH_VIEW_PASS=
DASH_SESSION_KEY=

# Layer 2 recovery on T: 1 = the agent starts guard.py (continuous vault + kill rule + containment) for the
# demo attack; 0 = the old plain watcher only. The dashboard "Recovery vault" panel needs 1.
GUARD=1

# v3 network layer (both off by default, so nothing changes unless you turn them on):
#   FLOOD=1      T also runs detector/flood_detector.py (DDoS, UDP flood, port scan, botnet) into the same chain pipeline.
#   BLOCK_TTL=N  T and P lift a block after N seconds (for example 3600) so a false positive is not permanent.
FLOOD=0
BLOCK_TTL=0

# v4 detectors on T (all off by default):
#   LOGIN_WATCH=1  slow brute force, password spraying, logins after failures / from Tor
#   ARP_WATCH=1    ARP spoofing (man-in-the-middle) on the local network
LOGIN_WATCH=0
ARP_WATCH=0

# v5 hardening (all optional, off when empty):
#   CHAIN_IP_KEY      same secret on D, T and P: threat records on the chain are stored encrypted (privacy).
#   WHITELIST_CIDRS   networks never to block, comma list, e.g. 10.0.0.0/8,192.168.0.0/16 (shared campus / mobile NAT)
#   SELFGUARD_KEY     secret that signs the defenders' code manifest (multi/selfguard.py)
CHAIN_IP_KEY=
WHITELIST_CIDRS=
SELFGUARD_KEY=

# v6 discovery (off by default). DISCOVERY=1: on T and P you only need D_IP (and the secrets); T_IP / P_IP can stay empty.
#   T and P register with D (signed, port REGISTRY_PORT) and learn each other's address; the dashboard follows them.
#   A_IP (the lab attacker) is still typed in: an attacker must never register itself as a trusted node.
#   Re-run `sudo multi/lockdown.sh D` after the peers have joined so the firewall rules use their addresses.
DISCOVERY=0
REGISTRY_PORT=8801

# v7 TLS (off by default). TLS=1: mutual TLS between the laptops with a private CA. On D run `multi/make_tls.sh` once, copy
# multi/tls/target to T and multi/tls/peer to P as multi/tls/node/ (never copy ca.key), set TLS=1 on all laptops.
# Ports with TLS: Fabric gateway 8600 (mutual TLS), dashboard https://D_IP:3443, agents 8800 and registry 8801 (now TLS), plain 3000 stays on D only.
TLS=0

# v9 Hyperledger Fabric (the chain; no gas, no coin, no Hardhat). D runs the Fabric network and the gateway; T and P use the gateway.
#   GATEWAY_PORT  port of the gateway on D (HTTP, or mutual TLS when TLS=1)
#   GATEWAY_LAB   1 = any authenticated laptop may use any Fabric identity (the demo target reports "as the peer" to reach K=2);
#                 0 = each certificate may use only its own identity (strict; the demo then reaches K=2 only with a second reporter)
GATEWAY_PORT=8600
GATEWAY_LAB=1

# v11 product settings
#   PEER_DETECT=1  P also guards its own SSH/logons and reports as node 2: a REAL second reporter, so GATEWAY_LAB=0 (strict) works
#   CONTAIN=apply  Layer 2 really quarantines the network after ransomware (needs D and P, which start_T.sh puts on the allow list);
#                  quarantine releases itself after QUARANTINE_MAX_S seconds (0 = never). Empty = file setting (dry = only print commands)
#   GATEWAY_RATE   requests per second per client the Fabric gateway accepts (burst x2); /metrics on the gateway is Prometheus text
PEER_DETECT=0
CONTAIN=
QUARANTINE_MAX_S=900
GATEWAY_RATE=50

# One-laptop testing only: T and P cannot both listen on 8800. Give P another port (D, T and P all need the same values).
T_AGENT_PORT=8800
P_AGENT_PORT=8800
