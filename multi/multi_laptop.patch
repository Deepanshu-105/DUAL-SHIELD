+fi
+(cd "$ROOT/blockchain" && npm install)
+(cd "$ROOT/dashboard" && npm install)
+[ -f "$ROOT/multi/config.env" ] || cp "$ROOT/multi/config.env.example" "$ROOT/multi/config.env"
