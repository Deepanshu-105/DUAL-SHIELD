+    if (!enabled) return;
+    let alive = true;
+    const go = async () => {
+      try {
+        const r = await fetch(url, { cache: "no-store" });
+        if (r.status === 401) { window.location.href = "/login"; return; }
+        const j = await r.json(); if (alive) setD(j);
+      } catch {}
+    };
+    go(); const id = setInterval(go, ms);
+    return () => { alive = false; clearInterval(id); };
+  }, [url, ms, enabled]);
+  return d;
